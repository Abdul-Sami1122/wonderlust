<% layout("/layouts/boilerplate") %>
<% if (typeof message !== 'undefined' && message) { %>
  <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
    <%= message %>
    <button
      type="button"
      class="btn-close btn-close-black"
      data-bs-dismiss="alert"
      aria-label="Close"
    ></button>
  </div>
<% } %>

<!-- Filters on page -->
<div id="filters" class="d-flex flex-nowrap overflow-auto p-2 align-items-center gap-2 my-3">
    <a href="/listings" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= (!activeCategory) ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-globe"></i></div>
        <p>All</p>
      </div>
    </a>
    <a href="/listings?category=trending<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'trending' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
    </a>
    <a href="/listings?category=rooms<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'rooms' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
      </div>
    </a>
    <a href="/listings?category=iconic_cities<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'iconic_cities' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
      </div>
    </a>
    <a href="/listings?category=mountain<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'mountain' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountain</p>
      </div>
    </a>
    <a href="/listings?category=castels<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'castels' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </div>
    </a>
    <a href="/listings?category=amazing_pools<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'amazing_pools' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
      </div>
    </a>
    <a href="/listings?category=camping<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'camping' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Camping</p>
      </div>
    </a>
    <a href="/listings?category=farms<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'farms' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </div>
    </a>
    <a href="/listings?category=arctic<%= activeKeyword ? '&keyword=' + encodeURIComponent(activeKeyword) : '' %><%= activeCity ? '&city=' + encodeURIComponent(activeCity) : '' %><%= activeMin ? '&min=' + activeMin : '' %><%= activeMax ? '&max=' + activeMax : '' %>" class="text-decoration-none">
      <div class="filter flex-shrink-0 me-1 <%= activeCategory === 'arctic' ? 'border-bottom border-2 border-danger fw-bold' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
      </div>
    </a>
</div>

<!-- Taxes Switch + Filters (City & Price Range in 1 Single Line on Desktop) -->
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center gap-3 my-3">
  <!-- Tax Toggle Box -->
  <div class="tax-toggle-box d-flex align-items-center border rounded-3 px-3 py-2 bg-surface shadow-sm" style="min-height: 42px;">
    <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
      <input
        class="form-check-input mt-0 cursor-pointer"
        type="checkbox"
        role="switch"
        id="switchCheckDefault"
      />
      <label class="form-check-label text-nowrap fw-semibold small cursor-pointer m-0 ms-1" for="switchCheckDefault">
        Display total after Taxes
      </label>
    </div>
  </div>

  <!-- Filter Form (City + Min + Max + Filter + Clear in ONE LINE on Desktop) -->
  <form action="/listings" method="GET" class="filter-bar-form d-flex align-items-center flex-wrap flex-sm-nowrap gap-2 p-2 border rounded-3 bg-surface shadow-sm">
    <% if (activeCategory) { %>
      <input type="hidden" name="category" value="<%= activeCategory %>" />
    <% } %>
    <% if (activeKeyword) { %>
      <input type="hidden" name="keyword" value="<%= activeKeyword %>" />
    <% } %>
    
    <!-- City Dropdown -->
    <select name="city" class="form-select form-select-sm filter-input" style="width: 140px; min-width: 125px;">
      <option value="">All Cities</option>
      <% if (typeof distinctCities !== 'undefined' && distinctCities.length) { %>
        <% for (let c of distinctCities) { %>
          <option value="<%= c %>" <%= (activeCity === c) ? 'selected' : '' %>><%= c %></option>
        <% } %>
      <% } %>
    </select>

    <!-- Min Price -->
    <input
      type="number"
      name="min"
      placeholder="Min Price"
      class="form-control form-control-sm filter-input"
      style="width: 105px; min-width: 95px;"
      value="<%= activeMin || '' %>"
    />

    <!-- Max Price -->
    <input
      type="number"
      name="max"
      placeholder="Max Price"
      class="form-control form-control-sm filter-input"
      style="width: 105px; min-width: 95px;"
      value="<%= activeMax || '' %>"
    />

    <!-- Filter Submit Button -->
    <button type="submit" class="btn btn-sm btn-dark px-3 text-nowrap">Filter</button>
    
    <!-- Clear Button -->
    <% if (activeCategory || activeMin || activeMax || activeKeyword || activeCity) { %>
      <a href="/listings" class="btn btn-sm btn-outline-secondary text-nowrap">Clear</a>
    <% } %>
  </form>
</div>

<!-- All listings Details -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% for(let listing of allListings) {%>
    <div class="col position-relative">
      <a href="/listings/<%= listing.id %>" class="listing-link text-decoration-none">
        <div class="card listing-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
          <img
            src="<%= (listing.image && listing.image.url) ? listing.image.url : '' %>"
            class="card-img-top card-images"
            alt="Listing Image"
            style="height: 18rem; object-fit: cover;"
          />
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br/>
              <span class="text-muted small"><%= listing.location %>, <%= listing.country %></span><br />
              Rs <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> /night
              <i class="tax-info">&nbsp;&nbsp; +18% GST</i>
            </p> 
          </div>
        </div>
      </a>
      <% if (currentUser) { %>
        <% const isFav = currentUser.wishlist && currentUser.wishlist.some(favId => favId.toString() === listing._id.toString()); %>
        <form action="/listings/<%= listing._id %>/wishlist" method="POST" class="position-absolute top-0 end-0 m-3" style="z-index: 5;">
          <button type="submit" class="btn wishlist-btn rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="<%= isFav ? 'Remove from Wishlist' : 'Add to Wishlist' %>">
            <i class="<%= isFav ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart"></i>
          </button>
        </form>
      <% } %>
    </div>
  <% } %> 
</div>

<!-- Pagination Controls -->
<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <% 
    const queryParams = [];
    if (activeCategory) queryParams.push(`category=${encodeURIComponent(activeCategory)}`);
    if (activeKeyword) queryParams.push(`keyword=${encodeURIComponent(activeKeyword)}`);
    if (typeof activeCity !== 'undefined' && activeCity) queryParams.push(`city=${encodeURIComponent(activeCity)}`);
    if (activeMin) queryParams.push(`min=${activeMin}`);
    if (activeMax) queryParams.push(`max=${activeMax}`);
    const baseQuery = queryParams.length ? '&' + queryParams.join('&') : '';
  %>
  <nav aria-label="Page navigation" class="mt-4 mb-4">
    <ul class="pagination justify-content-center align-items-center flex-wrap gap-1">
      <% if (currentPage > 1) { %>
        <li class="page-item">
          <a class="page-link rounded-pill px-3 fw-semibold" href="/listings?page=<%= currentPage - 1 %><%= baseQuery %>">
            <i class="fa-solid fa-chevron-left me-1"></i>Prev
          </a>
        </li>
      <% } else { %>
        <li class="page-item disabled">
          <span class="page-link rounded-pill px-3"><i class="fa-solid fa-chevron-left me-1"></i>Prev</span>
        </li>
      <% } %>

      <% for (let p = 1; p <= totalPages; p++) { %>
        <li class="page-item <%= p === currentPage ? 'active' : '' %>">
          <a class="page-link rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;" href="/listings?page=<%= p %><%= baseQuery %>">
            <%= p %>
          </a>
        </li>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <li class="page-item">
          <a class="page-link rounded-pill px-3 fw-semibold" href="/listings?page=<%= currentPage + 1 %><%= baseQuery %>">
            Next<i class="fa-solid fa-chevron-right ms-1"></i>
          </a>
        </li>
      <% } else { %>
        <li class="page-item disabled">
          <span class="page-link rounded-pill px-3">Next<i class="fa-solid fa-chevron-right ms-1"></i></span>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>