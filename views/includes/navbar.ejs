<!-- Main Navbar Header -->
<nav class="navbar navbar-expand-lg border-bottom sticky-top py-2 bg-theme">
  <div class="container-fluid px-3 px-md-4">
    <!-- Brand Logo -->
    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/listings">
      <i class="fa-regular fa-compass brand-icon text-danger fs-4"></i>
      <span class="brand-text fw-bold fs-5 text-theme">Wonderlust</span>
    </a>

    <!-- Compact Desktop Search Bar -->
    <form class="d-none d-lg-flex align-items-center nav-search-form me-auto ms-4" role="search" method="GET" action="/listings">
      <input class="form-control nav-search-input" type="search" name="keyword" placeholder="Search Destination..." aria-label="Search" />
      <button class="btn btn-search-compact" type="submit">
        <i class="fa-solid fa-magnifying-glass me-1"></i><span>Search</span>
      </button>
    </form>

    <!-- Desktop Navigation Links -->
    <div class="d-none d-lg-flex align-items-center gap-3">
      <a class="nav-link compact-nav-link" href="/listings/newlisting">
        <i class="fa-solid fa-circle-plus"></i><span>Add New Listing</span>
      </a>

      <% if (!currentUser) { %>
        <a class="nav-link compact-nav-link" href="/signup">
          <i class="fa-solid fa-user-plus"></i><span>Sign Up</span>
        </a>
        <a class="nav-link compact-nav-link" href="/login">
          <i class="fa-solid fa-arrow-right-to-bracket"></i><span>Log In</span>
        </a>
      <% } else { %>
        <a class="nav-link compact-nav-link user-profile-compact" href="/profile">
          <% if (currentUser.profileImage) { %>
            <img src="<%= currentUser.profileImage %>" alt="<%= currentUser.username %>" class="compact-avatar-img" />
          <% } else { %>
            <div class="compact-avatar-initials" style="background-color: <%= currentUser.color || '#f2242d' %>;">
              <%= currentUser.username.split(' ').map(name => name.charAt(0).toUpperCase()).slice(0, 2).join('') %>
            </div>
          <% } %>
          <span class="fw-semibold text-truncate user-name-label"><%= currentUser.username %></span>
        </a>

        <a class="nav-link compact-nav-link" href="/bookings">
          <i class="fa-solid fa-suitcase-rolling"></i><span>My Trips</span>
        </a>

        <a class="nav-link compact-nav-link" href="/wishlist">
          <i class="fa-solid fa-heart text-danger"></i><span>Wishlist</span>
        </a>

        <a class="nav-link compact-nav-link" href="/profile">
          <i class="fa-regular fa-user"></i><span>Account</span>
        </a>
      <% } %>

      <!-- Theme Switch (Desktop) -->
      <div class="form-check form-switch m-0 d-flex align-items-center gap-1 ms-2">
        <input class="form-check-input compact-switch" type="checkbox" role="switch" id="theme-toggle" onchange="toggleTheme()" />
        <label class="form-check-label small text-theme" for="theme-toggle">Dark</label>
      </div>
    </div>

    <!-- Mobile Hamburger Toggler Button -->
    <button
      class="navbar-toggler border-0 p-2 d-lg-none"
      type="button"
      data-bs-toggle="offcanvas"
      data-bs-target="#mobileSidebarMenu"
      aria-controls="mobileSidebarMenu"
      aria-label="Toggle navigation"
    >
      <i class="fa-solid fa-bars fs-3 text-theme"></i>
    </button>
  </div>
</nav>

<!-- Standalone Mobile Sidebar Offcanvas Drawer -->
<div class="offcanvas offcanvas-end d-lg-none theme-aware-sidebar" tabindex="-1" id="mobileSidebarMenu" aria-labelledby="mobileSidebarMenuLabel">
  <div class="offcanvas-header border-bottom p-3">
    <h5 class="offcanvas-title fw-bold" id="mobileSidebarMenuLabel">
      <i class="fa-regular fa-compass text-danger me-2"></i>Wonderlust
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body p-4 d-flex flex-column justify-content-between">
    <div>
      <!-- Mobile Search Form -->
      <form class="d-flex align-items-center mb-4" role="search" method="GET" action="/listings">
        <input class="form-control me-2 rounded-3" type="search" name="keyword" placeholder="Search destination..." aria-label="Search" />
        <button class="btn btn-danger rounded-3" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
      </form>

      <!-- Mobile Navigation Links -->
      <div class="nav flex-column gap-2">
        <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium" href="/listings">
          <i class="fa-solid fa-compass text-danger fs-5"></i> Explore Destinations
        </a>

        <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium" href="/listings/newlisting">
          <i class="fa-solid fa-circle-plus text-primary fs-5"></i> Host Property / Add Listing
        </a>

        <% if (!currentUser) { %>
          <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium" href="/login">
            <i class="fa-solid fa-arrow-right-to-bracket text-success fs-5"></i> Log In
          </a>

          <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium" href="/signup">
            <i class="fa-solid fa-user-plus text-info fs-5"></i> Sign Up
          </a>
        <% } else { %>
          <div class="p-3 mb-2 rounded-3 bg-surface border d-flex align-items-center gap-3">
            <% if (currentUser.profileImage) { %>
              <img src="<%= currentUser.profileImage %>" alt="<%= currentUser.username %>" style="width: 42px; height: 42px; object-fit: cover;" class="rounded-circle" />
            <% } else { %>
              <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 42px; height: 42px; background-color: <%= currentUser.color || '#f2242d' %>;">
                <%= currentUser.username.slice(0, 2).toUpperCase() %>
              </div>
            <% } %>
            <div>
              <h6 class="mb-0 fw-bold"><%= currentUser.username %></h6>
              <small class="text-muted"><%= currentUser.email || 'Member' %></small>
            </div>
          </div>

          <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium" href="/bookings">
            <i class="fa-solid fa-suitcase-rolling text-success fs-5"></i> My Trips & Bookings
          </a>

          <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium" href="/wishlist">
            <i class="fa-solid fa-heart text-danger fs-5"></i> Saved Wishlist
          </a>

          <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium" href="/profile">
            <i class="fa-regular fa-user text-warning fs-5"></i> Account Profile
          </a>

          <a class="nav-link sidebar-link p-3 rounded-3 d-flex align-items-center gap-3 fs-6 fw-medium text-danger" href="/logout">
            <i class="fa-solid fa-right-from-bracket fs-5"></i> Logout
          </a>
        <% } %>
      </div>
    </div>

    <!-- Theme Switch Footer in Sidebar -->
    <div class="border-top pt-3 mt-4">
      <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-surface">
        <span class="fw-semibold small"><i class="fa-solid fa-moon me-2 text-primary"></i>Dark Theme</span>
        <div class="form-check form-switch m-0 fs-5">
          <input class="form-check-input" type="checkbox" role="switch" id="theme-toggle-mobile" onchange="toggleTheme()" />
        </div>
      </div>
    </div>
  </div>
</div>